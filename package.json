{
  "name": "issuerollup",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic numeric Issue Field rollups for GitHub sub-issues.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run typecheck && npm test",
    "live:contract": "npm run build && node --enable-source-maps dist/src/live-contract.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
